# Copy to .env (never committed). The labs run without a key: the default model is the scripted
# stand-in, which replays recorded synthetic replies.
QAMAR_MODEL_MODE=stand-in
# For live runs: QAMAR_MODEL_MODE=live and a free OpenRouter key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
QAMAR_MODEL=google/gemma-4-31b-it:free
# 1 shrinks the generated event table and the timing repeats
QAMAR_QUICK=0
